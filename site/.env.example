# Copie ce fichier en ".env" puis remplis les valeurs. Le .env n'est jamais dans git :
# il se garde à part, sur le PC comme sur le VPS.

# --- Site ---
# Port du serveur Node. Sur le VPS, Caddy reçoit le HTTPS et renvoie vers ce port.
PORT=3000

# Adresse publique du site : liens des e-mails, retours de Battle.net, Google et Discord. En
# https, le cookie de connexion passe en Secure. Sur le VPS : https://groupscout.eu. Pour tester
# sur le PC, laisse-la vide : le site prend alors http://localhost:<PORT>.
# PUBLIC_URL=https://groupscout.eu

# --- Comptes ---
# Ces adresses deviennent administratrices dès leur inscription ou leur connexion, et sont
# vérifiées d'office. C'est ton filet de sécurité : tant que ton adresse est là, tu ne peux
# pas te retrouver enfermé dehors. Plusieurs adresses séparées par des virgules.
ADMIN_EMAILS=

# --- E-mails (Brevo : https://www.brevo.com) ---
# Code de vérification à 6 chiffres et lien de mot de passe oublié. Sans ces deux valeurs,
# le code ou le lien s'affiche dans la console du serveur : pratique pour tester en local.
# L'adresse d'expédition doit être sur un domaine authentifié chez Brevo (DKIM, DMARC),
# sinon les mails partent en spam. PUBLIC_URL est nécessaire pour les liens.
# BREVO_API_KEY=
# MAIL_FROM=noreply@groupscout.eu
# Formulaire de contact (/contact) : adresse qui reçoit les messages, jamais affichée sur le site
# CONTACT_EMAIL=contact@groupscout.eu

# --- Battle.net et API Blizzard ---
# Un seul client pour tout le site, à créer sur https://develop.battle.net/access/clients. Il sert
# à deux choses : lier le Battle.net d'un compte (liste de ses personnages, obligatoire pour
# poster une annonce ou postuler) et lire les profils des personnages (API Blizzard). Sans ces
# deux valeurs, personne ne peut participer et aucune fiche ne se charge.
# Adresses de retour (Redirect URLs) à déclarer chez Blizzard :
#   <PUBLIC_URL>/api/account/bnet/callback
#   http://localhost:3000/api/account/bnet/callback   (essais en local)
# BNET_CLIENT_ID=
# BNET_CLIENT_SECRET=
# Optionnel : adresse de retour, si elle n'est pas <PUBLIC_URL>/api/account/bnet/callback
# BNET_REDIRECT_URI=

# --- Se connecter avec Google ou Discord ---
# Un client par service pour tout le site. Sans ces valeurs, le bouton correspondant n'apparaît pas.
# Adresses de retour à déclarer à l'identique chez eux :
#   <PUBLIC_URL>/api/auth/google/callback   (Google Cloud Console > Identifiants > ID client OAuth)
#   <PUBLIC_URL>/api/auth/discord/callback  (discord.com/developers > ton application > OAuth2 > Redirects)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# --- Données (tout est créé au premier lancement, dans data/) ---
# Base des comptes, Battle.net liés, annonces, notifications et mesure d'audience (SQLite)
# ACCOUNTS_FILE=data/groupscout.db

# Icônes d'objets (Clean Icons - Mechagnome Edition, lues à la demande dans le paquet sur GitHub) :
# autre version du paquet, et dossier où garder les icônes converties (défaut data/icons)
# ICON_PACK_URL=
# ICONS_DIR=

# Images du Journal des rencontres (portraits des boss, scènes des instances, lues sur wago.tools) :
# dossier où garder les PNG décodés (défaut data/journal)
# JOURNAL_DIR=
